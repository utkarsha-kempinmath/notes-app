<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white ">
        <a class="text-blue-500 inline-block" href="/">Go back to home</a>
        <div class="form py-5 text-white">
            <form action="/edit" method="post">
                <input class="block text-zinc-400 mt-5 mb-5 px-5 py-2 w-1/4 rounded-md outline-none bg-zinc-800" readonly type="text"
                placeholder="Previous Name" name="title" value="<%= note._id %>">
                <input class="block px-5 py-2 w-1/4 rounded-md outline-none  bg-zinc-800" type="text"
                    placeholder="New Title" name="newTitle" value="<%= note.title %>">
                <input class="mt-5 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Update Name">
            </form>
        </div>
    </div>
</body>