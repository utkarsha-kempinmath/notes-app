<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Notes App</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 min-h-screen text-white">

  <div class="max-w-4xl mx-auto p-6">

    <h1 class="text-3xl font-bold mb-6">
      Welcome to your Notes App
    </h1>

    <!-- Create Note -->
    <form action="/create" method="POST" class="space-y-4 mb-10">
      <input
        type="text"
        name="title"
        placeholder="Title goes here"
        class="w-full p-3 rounded bg-zinc-800 outline-none"
        required
      />

      <textarea
        name="details"
        placeholder="Write your task details here"
        class="w-full p-3 rounded bg-zinc-800 outline-none h-32"
        required
      ></textarea>

      <button
        class="bg-blue-600 px-4 py-2 rounded hover:bg-blue-700"
      >
        Create Task
      </button>
    </form>

    <!-- Notes List -->
    <% if (files.length === 0) { %>
      <p class="text-zinc-400">No notes yet.</p>
    <% } else { %>
      <div class="grid gap-6">
        <% files.forEach(file => { %>
          <div class="bg-zinc-800 p-5 rounded">
            <h3 class="text-xl font-semibold mb-2">
              <%= file.title %>
            </h3>

            <p class="text-zinc-300 mb-3">
              <%= file.content.length > 100
                ? file.content.substring(0, 100) + "..."
                : file.content
              %>
            </p>

            <div class="flex gap-4">
              <a
                href="/files/<%= file._id %>"
                class="text-blue-400 hover:underline"
              >
                Read more
              </a>

              <a
                href="/edit/<%= file._id %>"
                class="text-yellow-400 hover:underline"
              >
                Edit
              </a>

              <form
                action="/delete/<%= file._id %>"
                method="POST"
              >
                <button class="text-red-400 hover:underline">
                  Delete
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>

</body>
</html>