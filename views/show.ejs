<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white ">
        <a class="text-blue-500 inline-block" href="/">Go back to home</a>
        <h1 class="text-3xl tracking-tighter mt-10">
            <%= note.title %>
        </h1>
        <p class="text-xl mt-2 font-light">
            <%= note.content %>
        </p>
        <div class="mt-3">
        <form action="/edit/<%= note._id %>"  method="get">
                            <button type="submit"
                                class="mt-3 bg-yellow-500 px-5 py-2 rounded-md text-white">
                                Edit Filename
                            </button>
                        </form>
            <button type="submit" class="mt-2 bg-red-500 px-5 py-2 rounded-md text-white">
                Delete
            </button>
        </form>
        </div>
    </div>
</body>

</html>